							"raw": "{\n  \"nombre\": \"María García\",\n  \"email\": \"maria@example.com\",\n  \"telefono\": \"+5493414567891\",\n  \"dni\": \"87654321\",\n  \"cuentaBancaria\": {\n    \"numeroCuenta\": \"001234567890\",\n    \"cbu\": \"0123456789012345678901\",\n    \"idBanco\": 1\n  }\n}"
